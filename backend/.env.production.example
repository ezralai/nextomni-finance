# ==============================================================================
# NextOmni Finance API — 100% Free Production Cloud Deployment Blueprint
# Target Architecture: Render / Koyeb (API) + Supabase / Neon (PostgreSQL 16) + Vercel (Nuxt 3)
# ==============================================================================

# Core Application Settings
APP_NAME="NextOmni Finance"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://nextomni-api.onrender.com

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Free Cloud Database: Supabase or Neon.tech (PostgreSQL 16)
# Note: For Supabase, use port 6543 (transaction pooling) or 5432 (direct session)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SECURE_SUPABASE_PASSWORD
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Zero-Cost Serverless State: Running on Managed PostgreSQL without Paid Redis
# ------------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

# Container Continuous Deployment Automation
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# ------------------------------------------------------------------------------
# Security, Sanctum & Production CORS Policies
# ------------------------------------------------------------------------------
FRONTEND_URL=https://nextomni-finance.vercel.app
CORS_ALLOWED_ORIGINS=https://nextomni-finance.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS="{^https:\/\/.*\.vercel\.app$}i"
SANCTUM_STATEFUL_DOMAINS=nextomni-finance.vercel.app

# System Security
BCRYPT_ROUNDS=12
